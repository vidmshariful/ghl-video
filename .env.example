# GHL Video native checkout: environment variables.
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; NEVER commit real keys. LIVE secret keys go only in the
# Vercel dashboard, never in this repo.

# --- Site ---------------------------------------------------------------
# Absolute origin, used to build return URLs and the Stripe webhook target.
NEXT_PUBLIC_SITE_URL=https://ghlvideo.com

# --- Stripe (use TEST keys for the whole build; live keys only in Vercel)
# From the website's own Stripe account (the new sub-account under the org,
# NOT the one connected to HighLevel), in Test mode: Developers > API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx   # publishable, safe on the client
STRIPE_SECRET_KEY=sk_test_xxx                    # secret, server only
# Signing secret for the /api/webhooks/stripe endpoint. Created when the
# webhook endpoint is registered (Stripe CLI for local, dashboard for prod).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xdarleyimthsnareuoxl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # publishable, RLS-limited
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # server only; runtime data ops
# Postgres connection string (Session mode, includes password). Only used
# to APPLY migrations/DDL from a trusted shell; not read by the app at runtime.
SUPABASE_DB_URL=postgresql://postgres.xdarleyimthsnareuoxl:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- HighLevel (LeadConnector) API v2 -----------------------------------
# Private Integration token (pit-...), scoped to the website's location.
HIGHLEVEL_API_TOKEN=pit-xxx
HIGHLEVEL_LOCATION_ID=xxx                        # the subaccount's Location ID
HIGHLEVEL_API_VERSION=2021-07-28                 # required Version header
# Opportunity target: filled once we list the pipelines against your location.
HIGHLEVEL_PIPELINE_ID=xxx
HIGHLEVEL_STAGE_ID=xxx                            # the "paid/won" stage
# Where website quote leads land (setter pipeline / New Lead stage). If
# unset, the code falls back to the current production ids and logs a
# warning; set these in Vercel to reroute without a deploy.
HIGHLEVEL_LEAD_PIPELINE_ID=xxx
HIGHLEVEL_LEAD_STAGE_ID=xxx

# --- Dev toggles --------------------------------------------------------
# Set to 1 to skip the build-time Supabase chrome fetch (offline dev builds
# use the static fallback in lib/site.ts).
# CHROME_OFFLINE=1

# --- Region + VPN gate (proxy.ts) ---------------------------------------
# Blocks visitors from BLOCKED_COUNTRIES and (if PROXYCHECK_API_KEY is set)
# anyone on a VPN/proxy, at the edge. SAFETY: nothing enforces unless
# ACCESS_BYPASS_KEY is set, so the team can never be locked out by a missing
# key. Unlock from anywhere by visiting /unlock?key=<value> once (year-long
# cookie; also exempts the VPN check). Set the keys in Vercel to turn it on.
# Extra unlock keys for the team, comma separated. Any of them works exactly
# like the owner key above. Revoke a teammate by deleting their key from this
# list and redeploying; the owner key is untouched.
ACCESS_BYPASS_KEYS=

ACCESS_BYPASS_KEY=xxx                             # secret for /unlock?key=...
BLOCKED_COUNTRIES=BD,PK                           # comma-separated ISO codes
PROXYCHECK_API_KEY=xxx                            # proxycheck.io key; omit to skip VPN check

# --- Transactional email (lib/email) ------------------------------------
# Client emails (order updates) via Brevo's API. Same Brevo account as the
# Supabase auth SMTP: generate a key under SMTP & API -> API Keys. Without
# BREVO_API_KEY, sends are skipped (logged), never erroring. Templates are
# admin-managed (Admin -> Email Templates).
BREVO_API_KEY=xxx                                 # Brevo API key; omit to disable sending
EMAIL_FROM=hi@ghlvideo.com                        # verified Brevo sender
EMAIL_FROM_NAME=GHL Video                         # sender display name

# --- FirstPromoter (partner portal, phase 2) -----------------------------
# API access for pulling partner stats (clicks, referrals, earnings) into
# /partners. Phase 1 (links + assets + admin) works without these. Set the
# key in Vercel + .env.local yourself; never commit real values.
FIRSTPROMOTER_API_KEY=xxx                         # FirstPromoter API key
FIRSTPROMOTER_ACCOUNT_ID=xxx                      # FirstPromoter account id

# --- Team email alerts ---------------------------------------------------
ADMIN_ALERT_EMAIL=hi@ghlvideo.com                 # where new-order/application/dispute alerts go

# Optional override for the review link in the wrap-up email. The real one
# lives in lib/content/core.ts with the rest of the content, so this is only
# needed to point the ask somewhere else, or to empty it and drop the ask,
# without a deploy.
GOOGLE_REVIEW_URL=

# ---- Scheduled checks ----
# Vercel signs its cron calls with this. Set it in Vercel (any long random
# string) and Vercel sends it automatically; the endpoint then refuses anyone
# else. Optional: without it the daily price check still runs, it is just not
# restricted to Vercel. Nothing sensitive is exposed either way, since the
# check only compares prices already shown on the pricing page.
CRON_SECRET=
